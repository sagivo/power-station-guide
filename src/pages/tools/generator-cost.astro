---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { MODELS } from "../../data/models";
import { amazonLink } from "../../lib/amazon";
import { SITE_NAME, SITE_URL } from "../../lib/site";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Visual from "../../components/Visual.astro";
import { breadcrumbLd } from "../../lib/schema";

const title = "Power Station vs Generator: 5-Year Cost Calculator";
const description =
  "Compare the true 5-year cost of a portable power station against a gas standby or portable generator: fuel, oil, maintenance, and replacement included.";
const url = `${SITE_URL}/tools/generator-cost/`;

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Tools", href: "/tools/" },
  { name: "Generator cost comparison", href: "/tools/generator-cost/" },
];
const jsonLd = [
  breadcrumbLd(crumbs),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Power Station vs Generator Cost Calculator",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    url,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Is a portable power station cheaper than a generator?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "For occasional outages it often is: no fuel, no oil changes, no maintenance visits. A gas generator looks cheaper upfront but its fuel and upkeep add up over 5 years, especially with frequent or long outages.",
        },
      },
      {
        "@type": "Question",
        name: "How long do portable power stations last?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "LiFePO4 stations are typically rated for 3,000-4,000+ charge cycles to 80% capacity — a decade or more of occasional outage use. Gas generators need oil, filters, and exercise runs on a schedule regardless of use.",
        },
      },
    ],
  },
];

const modelsJson = JSON.stringify(
  MODELS.map((m) => ({
    id: m.id, name: m.name, capacityWh: m.capacityWh, outputW: m.outputW,
    priceLow: m.priceLow, priceHigh: m.priceHigh,
    link: amazonLink(m.query, m.asin),
  })).sort((a, b) => a.capacityWh - b.capacityWh)
);
---

<BaseLayout title={title} description={description} canonical={url} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />
    <div class="calc-hero">
      <h1>Power station vs generator: 5-year cost</h1>
      <p>
        A gas generator looks cheaper on the shelf — then you buy fuel, oil, and
        maintenance for five years. Enter your outage pattern and see the real total
        next to a comparable power station.
      </p>
    </div>

    <div class="calc" id="cost-calc">
      <div class="row">
        <div>
          <label for="station">Power station</label>
          <select id="station">
            {MODELS.map((m) => (
              <option value={m.id}>{m.name} — ~${m.priceLow.toLocaleString("en-US")}–${m.priceHigh.toLocaleString("en-US")}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="genprice">Comparable gas generator price <output id="genprice-out">$900</output></label>
          <input id="genprice" type="range" min="300" max="3000" step="50" value="900" />
        </div>
      </div>
      <div class="row">
        <div>
          <label for="outages">Outage hours per year <output id="outages-out">48 h</output></label>
          <input id="outages" type="range" min="0" max="300" step="12" value="48" />
        </div>
        <div>
          <label for="fuel">Gasoline price <output id="fuel-out">$3.50/gal</output></label>
          <input id="fuel" type="range" min="2.5" max="6" step="0.1" value="3.5" />
        </div>
      </div>
      <p style="margin-top:1.5rem;"><button class="btn" id="cost-btn" type="button">Compare 5-year cost ⚡</button></p>
      <div class="calc-result" id="cost-result" aria-live="polite"></div>
    </div>

    <article class="prose" data-pagefind-body>
      <h2>What the math includes</h2>
      <p>
        Gas generators burn roughly 0.75 gal/hour under moderate load, plus about
        $60/year in oil, filters, and spark plugs, and a $300 replacement budget
        across five years for wear parts. Power stations cost electricity to recharge
        (about $0.17/kWh) and nothing else — no oil, no filters, no exercise runs.
      </p>
      <p>
        For the full breakdown of noise, fumes, and maintenance differences, read our
        <a href="/posts/power-station-vs-generator/">power station vs standby generator</a> guide.
      </p>
    </article>
  </div>

  <script define:vars={{ modelsJson, siteName: SITE_NAME }}>
    const MODELS = JSON.parse(modelsJson);
    const $ = (id) => document.getElementById(id);
    const genprice = $("genprice"), outages = $("outages"), fuel = $("fuel"), station = $("station");

    function paint(el) {
      const pct = ((el.value - el.min) / (el.max - el.min)) * 100;
      el.style.setProperty("--fill", pct + "%");
    }
    function fmt(n) { return "$" + Math.round(n).toLocaleString("en-US"); }

    function sync() {
      [genprice, outages, fuel].forEach(paint);
      $("genprice-out").textContent = fmt(genprice.value);
      $("outages-out").textContent = outages.value + " h";
      $("fuel-out").textContent = "$" + parseFloat(fuel.value).toFixed(2) + "/gal";
    }
    [genprice, outages, fuel].forEach((el) => el.addEventListener("input", sync));
    sync();

    $("cost-btn").addEventListener("click", () => {
      const m = MODELS.find((x) => x.id === station.value);
      const years = 5;
      const hrs = parseFloat(outages.value), gas = parseFloat(fuel.value);
      const genUpfront = parseFloat(genprice.value);
      // Gas: ~0.75 gal/h moderate load + $60/yr maintenance + $300 wear parts over 5yr.
      const genFuel = hrs * 0.75 * gas * years;
      const genMaint = 60 * years + 300;
      const genTotal = genUpfront + genFuel + genMaint;
      // Station: mid-range of typical price + recharge electricity at $0.17/kWh.
      const stUpfront = (m.priceLow + m.priceHigh) / 2;
      const cycles = (m.capacityWh / 1000) * (hrs / 24) * years; // rough full-cycle equivalents
      const stEnergy = cycles * 0.17;
      const stTotal = stUpfront + stEnergy;
      const winner = stTotal < genTotal ? "station" : "generator";
      const result = $("cost-result");
      result.innerHTML = `
        <h3>The ${winner === "station" ? m.name : "gas generator"} wins on 5-year cost</h3>
        <table class="compat-table">
          <tr><td>Upfront</td><td><strong>${fmt(stUpfront)}</strong> station</td><td><strong>${fmt(genUpfront)}</strong> generator</td></tr>
          <tr><td>5-yr fuel &amp; energy</td><td><strong>${fmt(stEnergy)}</strong></td><td><strong>${fmt(genFuel)}</strong></td></tr>
          <tr><td>5-yr maintenance</td><td><strong>$0</strong></td><td><strong>${fmt(genMaint)}</strong></td></tr>
          <tr><td><strong>5-year total</strong></td><td><strong style="font-size:1.2rem;">${fmt(stTotal)}</strong></td><td><strong style="font-size:1.2rem;">${fmt(genTotal)}</strong></td></tr>
        </table>
        <p style="font-size:.87rem;">${winner === "station"
          ? "The station's higher sticker price is erased by zero fuel and maintenance. It also runs silent indoors with no fumes."
          : "With this much runtime, cheap gasoline beats the station's upfront cost. But the generator is loud, needs oil changes, and can't run indoors."}</p>
        <p class="disclosure">As an Amazon Associate ${siteName} earns from qualifying purchases. Check Amazon for today's price.</p>`;
      result.classList.add("show");
      result.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  </script>
</BaseLayout>
