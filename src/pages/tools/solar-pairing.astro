---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { MODELS } from "../../data/models";
import { amazonLink } from "../../lib/amazon";
import { SITE_NAME, SITE_URL } from "../../lib/site";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Visual from "../../components/Visual.astro";
import { breadcrumbLd } from "../../lib/schema";

const title = "Solar Pairing Calculator — How Fast Panels Recharge Each Power Station";
const description =
  "Pick a power station and your panel wattage to estimate solar recharge time, and see which stations make the most of the panels you own.";
const url = `${SITE_URL}/tools/solar-pairing/`;

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Tools", href: "/tools/" },
  { name: "Solar pairing calculator", href: "/tools/solar-pairing/" },
];
const jsonLd = [
  breadcrumbLd(crumbs),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Solar Pairing Calculator",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    url,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "How long does it take to charge a power station with solar panels?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Divide the station's watt-hours by your panels' real-world output (about 70% of the rated watts). A 2,000Wh station on 400W of panels takes roughly 7 hours of good sun. Stations cap input at their max solar rating, so oversized arrays don't help.",
        },
      },
      {
        "@type": "Question",
        name: "Can I use any solar panel with my power station?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Mostly yes, as long as the panel's voltage stays within the station's solar input range and the wattage doesn't exceed its max. Check your station's VOC limit in the specs before wiring panels in series.",
        },
      },
    ],
  },
];

const modelsJson = JSON.stringify(
  MODELS.map((m) => ({
    id: m.id, name: m.name, capacityWh: m.capacityWh, solarInputW: m.solarInputW,
    link: amazonLink(m.query, m.asin),
  })).sort((a, b) => a.capacityWh - b.capacityWh)
);
---

<BaseLayout title={title} description={description} canonical={url} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />
    <div class="calc-hero">
      <h1>Solar pairing calculator</h1>
      <p>
        Panels are rated in perfect lab sun — you get about 70% of that in the real
        world. Pick your station and your array, and we'll estimate the 0–100% solar
        recharge time and flag when your panels are capped by the station's input limit.
      </p>
    </div>

    <div class="calc" id="solar-calc">
      <div class="row">
        <div>
          <label for="model">Power station</label>
          <select id="model">
            {MODELS.map((m) => (
              <option value={m.id}>{m.name} — {(m.capacityWh / 1000).toFixed(m.capacityWh % 1000 ? 1 : 0)}kWh, {m.solarInputW.toLocaleString("en-US")}W max solar</option>
            ))}
          </select>
        </div>
        <div>
          <label for="panels">Panel array rated watts <output id="panels-out">400W</output></label>
          <input id="panels" type="range" min="100" max="1600" step="50" value="400" />
        </div>
      </div>
      <p style="margin-top:1.5rem;"><button class="btn" id="solar-btn" type="button">Calculate recharge ⚡</button></p>
      <div class="calc-result" id="solar-result" aria-live="polite"></div>
    </div>

    <article class="prose" data-pagefind-body>
      <Visual name="chart:solar-input" />
      <h2>Max solar input across our database</h2>
      <p>
        A station can only drink what its solar controller allows. The chart above shows
        each model's ceiling — pairing a 1,600W array with a station capped at 800W
        wastes half your panels. Size the array to the station, not the other way around.
      </p>
      <p>
        For panel picks and wiring tips, read our
        <a href="/posts/solar-panel-pairing-guide/">solar panel pairing guide</a>.
      </p>
    </article>
  </div>

  <script define:vars={{ modelsJson, siteName: SITE_NAME }}>
    const MODELS = JSON.parse(modelsJson);
    const $ = (id) => document.getElementById(id);
    const panels = $("panels"), modelSel = $("model");

    function paint(el) {
      const pct = ((el.value - el.min) / (el.max - el.min)) * 100;
      el.style.setProperty("--fill", pct + "%");
    }
    function fmtTime(h) {
      if (h < 1) return Math.round(h * 60) + " min";
      const whole = Math.floor(h), min = Math.round((h - whole) * 60);
      return min ? `${whole}h ${min}m` : `${whole}h`;
    }

    function sync() {
      paint(panels);
      $("panels-out").textContent = panels.value + "W";
    }
    panels.addEventListener("input", sync);
    sync();

    $("solar-btn").addEventListener("click", () => {
      const m = MODELS.find((x) => x.id === modelSel.value);
      const rated = parseFloat(panels.value);
      const real = rated * 0.7; // real-world derating
      const effective = Math.min(real, m.solarInputW);
      const hours = m.capacityWh / effective;
      const capped = real > m.solarInputW;
      const result = $("solar-result");
      result.innerHTML = `
        <h3>${m.name}: about ${fmtTime(hours)} of good sun</h3>
        <table class="compat-table">
          <tr><td>Array rated</td><td><strong>${rated}W</strong></td></tr>
          <tr><td>Real-world output (70%)</td><td><strong>${Math.round(real)}W</strong></td></tr>
          <tr><td>Station accepts</td><td><strong>${Math.round(effective)}W${capped ? ` (capped at ${m.solarInputW.toLocaleString("en-US")}W max)` : ""}</strong></td></tr>
          <tr><td>0–100% recharge</td><td><strong>~${fmtTime(hours)}</strong></td></tr>
        </table>
        ${capped
          ? `<p style="font-size:.87rem;">⚠️ Your array is capped — ${Math.round(real - m.solarInputW)}W of panel goes unused on this station. A smaller array (or a station with a bigger solar input) wastes less.</p>`
          : `<p style="font-size:.87rem;">✅ Good pairing — the station uses everything your panels produce.</p>`}
        <p class="fine">Estimates assume clear midday sun. Clouds, panel angle, and heat cut output further.</p>
        <p class="disclosure">As an Amazon Associate ${siteName} earns from qualifying purchases. Check Amazon for today's price.</p>`;
      result.classList.add("show");
      result.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  </script>
</BaseLayout>
