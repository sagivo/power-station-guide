---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { MODELS, formatWh } from "../../data/models";
import { amazonLink } from "../../lib/amazon";
import { SITE_NAME, SITE_URL } from "../../lib/site";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Visual from "../../components/Visual.astro";
import { breadcrumbLd } from "../../lib/schema";

const title = "RV Power Sizer — What Size Power Station Do I Need?";
const description =
  "Check off the devices you run in your RV or van and get the watt-hours you need, plus which portable power stations in our database can cover them.";
const url = `${SITE_URL}/tools/rv-sizer/`;

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Tools", href: "/tools/" },
  { name: "RV power sizer", href: "/tools/rv-sizer/" },
];
const jsonLd = [
  breadcrumbLd(crumbs),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "RV Power Sizer",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    url,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What size power station do I need for my RV?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Add up each device's watts times the hours you run it per day, then add 20% headroom. A 2,000Wh station covers a fridge, lights, laptops and phones for most van setups; RV air conditioning needs 3,000Wh or more.",
        },
      },
      {
        "@type": "Question",
        name: "Can a portable power station run an RV air conditioner?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Only the large ones. A typical 13,500 BTU RV AC draws 1,200-1,800W running and surges higher at startup, so you need at least 3,000W continuous output and 3,000Wh or more capacity for a few hours of cooling.",
        },
      },
    ],
  },
];

const DEVICES = [
  { name: "12V RV fridge", watts: 60, hours: 24, note: "cycles on/off; ~8h effective draw" },
  { name: "LED lights", watts: 20, hours: 5, note: "" },
  { name: "Laptop", watts: 65, hours: 6, note: "" },
  { name: "Phone charging", watts: 20, hours: 3, note: "" },
  { name: "Starlink / router", watts: 40, hours: 8, note: "" },
  { name: "Vent fan (MaxxAir)", watts: 30, hours: 8, note: "" },
  { name: "Electric kettle", watts: 1200, hours: 0.25, note: "short bursts" },
  { name: "Microwave", watts: 1000, hours: 0.25, note: "short bursts" },
  { name: "Portable AC (5,000 BTU)", watts: 500, hours: 4, note: "" },
  { name: "RV rooftop AC (13,500 BTU)", watts: 1500, hours: 4, note: "needs soft start" },
];

const modelsJson = JSON.stringify(
  MODELS.map((m) => ({
    id: m.id, name: m.name, capacityWh: m.capacityWh, outputW: m.outputW,
    priceLow: m.priceLow, priceHigh: m.priceHigh, bestFor: m.bestFor,
    link: amazonLink(m.query, m.asin),
  }))
);
---

<BaseLayout title={title} description={description} canonical={url} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />
    <div class="calc-hero">
      <h1>RV &amp; vanlife power sizer</h1>
      <p>
        Undersized stations die at 2am with the fridge. Check off the devices you run,
        tell us the hours, and we'll total your daily watt-hours and match stations
        that can actually cover them.
      </p>
    </div>

    <div class="calc" id="rv-calc">
      <label style="margin-top:0">Which devices do you run? <output id="dev-out">0 selected</output></label>
      <div id="devices">
        {DEVICES.map((d, i) => (
          <div class="row" style="align-items:center;margin-bottom:.4rem;">
            <label style="margin:0;font-weight:600;justify-content:flex-start;">
              <input type="checkbox" class="dev-check" data-i={i} checked={i < 6} style="width:1.2rem;height:1.2rem;accent-color:#1e6b32;" />
              <span>{d.name} <span style="color:#5c6f60;font-weight:400;">· {d.watts}W{d.note ? ` (${d.note})` : ""}</span></span>
            </label>
            <label style="margin:0;">Hours / day
              <input type="number" class="dev-hours" data-i={i} min="0.25" max="24" step="0.25" value={d.hours} style="max-width:7rem;" />
            </label>
          </div>
        ))}
      </div>
      <div class="row">
        <div>
          <label for="days">Days off-grid between recharges <output id="days-out">1 day</output></label>
          <input id="days" type="range" min="1" max="4" step="1" value="1" />
        </div>
        <div>
          <label for="headroom">Headroom <output id="headroom-out">20%</output></label>
          <input id="headroom" type="range" min="0" max="50" step="5" value="20" />
        </div>
      </div>
      <p style="margin-top:1.5rem;"><button class="btn" id="size-btn" type="button">Size my setup ⚡</button></p>
      <div class="calc-result" id="size-result" aria-live="polite"></div>
    </div>

    <article class="prose" data-pagefind-body>
      <Visual name="diagram:sizing" />
      <h2>How the sizing works</h2>
      <p>
        We multiply each device's watts by its daily hours, multiply by your off-grid
        days, then add headroom (20% is the sweet spot — it covers inverter losses and
        the fact that you never want to drain to zero). We only recommend stations whose
        continuous output clears your biggest single device.
      </p>
      <p>
        Pairing with solar? Run the numbers through our
        <a href="/tools/solar-pairing/">solar pairing calculator</a> to see how fast
        panels refill each station. For the full walkthrough, read our
        <a href="/posts/rv-vanlife-power-sizing/">RV and vanlife power sizing guide</a>.
      </p>
    </article>
  </div>

  <script define:vars={{ modelsJson, devicesJson: JSON.stringify(DEVICES), siteName: SITE_NAME }}>
    const MODELS = JSON.parse(modelsJson);
    const DEVICES = JSON.parse(devicesJson);
    const $ = (id) => document.getElementById(id);
    const days = $("days"), headroom = $("headroom");

    function paint(el) {
      const pct = ((el.value - el.min) / (el.max - el.min)) * 100;
      el.style.setProperty("--fill", pct + "%");
    }
    function fmt(n) { return Math.round(n).toLocaleString("en-US"); }
    function fmtWh(n) { return n >= 1000 ? (n / 1000).toFixed(n % 1000 ? 1 : 0) + "kWh" : Math.round(n) + "Wh"; }

    function sync() {
      [days, headroom].forEach(paint);
      $("days-out").textContent = days.value + (days.value === "1" ? " day" : " days");
      $("headroom-out").textContent = headroom.value + "%";
      const n = document.querySelectorAll(".dev-check:checked").length;
      $("dev-out").textContent = n + " selected";
    }
    [days, headroom].forEach((el) => el.addEventListener("input", sync));
    document.querySelectorAll(".dev-check").forEach((el) => el.addEventListener("change", sync));
    sync();

    $("size-btn").addEventListener("click", () => {
      let wh = 0, maxWatts = 0;
      const picked = [];
      document.querySelectorAll(".dev-check").forEach((box) => {
        if (!box.checked) return;
        const d = DEVICES[+box.dataset.i];
        const hrs = parseFloat(document.querySelector(`.dev-hours[data-i="${box.dataset.i}"]`).value) || 0;
        wh += d.watts * hrs;
        if (d.watts > maxWatts) maxWatts = d.watts;
        picked.push(d.name);
      });
      const need = wh * parseFloat(days.value) * (1 + parseFloat(headroom.value) / 100);
      const result = $("size-result");

      if (!picked.length) {
        result.innerHTML = "<h3>Select at least one device</h3><p>Check the devices you actually run and we'll size from there.</p>";
      } else {
        const fits = MODELS
          .filter((m) => m.capacityWh >= need && m.outputW >= maxWatts)
          .sort((a, b) => a.capacityWh - b.capacityWh)
          .slice(0, 3);
        const cards = fits.length
          ? fits.map((m, i) => `
            <div class="model-pick">
              <h4>${i === 0 ? "⭐ Best match: " : ""}<a href="/power-stations/${m.id}/">${m.name}</a></h4>
              <p class="specs">${fmtWh(m.capacityWh)} · ${fmt(m.outputW)}W output · $${fmt(m.priceLow)}–$${fmt(m.priceHigh)} typical</p>
              <p>${m.bestFor}</p>
              <div class="pc-actions"><a class="btn buy btn-sm" href="${m.link}" rel="sponsored nofollow noopener" target="_blank">Check price</a><a class="pc-review" href="/power-stations/${m.id}/">Full review</a></div>
            </div>`).join("")
          : `<div class="model-pick"><h4>No single station covers it</h4><p class="specs">You need ~${fmtWh(need)} and ${fmt(maxWatts)}W output</p><p>Your load is too big for one portable unit. Split high-draw devices (AC, kettle) onto a second station, or look at the expandable models like the Delta Pro 3 that stack extra batteries.</p></div>`;
        result.innerHTML = `<h3>You need about ${fmtWh(need)}</h3>
          <p class="specs">Daily draw: ~${fmtWh(wh)} across ${picked.length} device${picked.length > 1 ? "s" : ""} · biggest single load: ${fmt(maxWatts)}W</p>
          ${cards}
          <p class="disclosure">As an Amazon Associate ${siteName} earns from qualifying purchases. Check Amazon for today's price.</p>`;
      }
      result.classList.add("show");
      result.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  </script>
</BaseLayout>
