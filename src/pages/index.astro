---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import PostCard from "../components/PostCard.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import ProductImage from "../components/ProductImage.astro";
import BuyButton from "../components/BuyButton.astro";
import StickyCta from "../components/StickyCta.astro";
import PriceTier from "../components/PriceTier.astro";
import { SITE_NAME, SITE_DESCRIPTION } from "../lib/site";
import { MODELS, getModel, priceTier, formatWh } from "../data/models";
import { getPosts } from "../lib/posts";
import { websiteLd, faqLd, itemListLd } from "../lib/schema";
import { HOME_PICKS } from "../data/picks";

const posts = await getPosts();
const latest = [...posts].sort(
  (a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf()
);
const guides = latest.filter((p) => p.data.category !== "best").slice(0, 6);
const topModels = [...MODELS].sort((a, b) => b.capacityWh - a.capacityWh).slice(0, 6);
const picks = HOME_PICKS.map((p) => ({ ...p, model: getModel(p.id) }));

const top = picks[0].model;
// Award colours for the four homepage picks.
const ACCENTS = ["#c8f03c", "#ff9a6b", "#7fd8c6", "#ffd34f"];

// Each use-case tile shows the #1 pick from its guide, so readers can buy straight from the homepage.
const useCases = [
  { slug: "rv-vanlife-power-sizing", icon: "🚐", title: "RV & vanlife", text: "Size a station for fridge, Starlink and cooking on the road." },
  { slug: "power-station-vs-generator", icon: "⚖️", title: "Station vs generator", text: "Silent battery vs gas: cost, noise and runtime compared." },
  { slug: "solar-panel-pairing-guide", icon: "☀️", title: "Solar pairing", text: "Which panels recharge which stations — and how fast." },
  { slug: "best-budget-power-station", icon: "💵", title: "On a budget", text: "The best 1kWh stations you can buy for less." },
  { slug: "home-backup-outage-scenarios", icon: "🏠", title: "Home backup", text: "Match a station to real outage scenarios, hour by hour." },
  { slug: "what-size-power-station", icon: "📐", title: "What size do I need?", text: "Capacity vs output explained with real appliance math." },
].map((y) => {
  const first = posts.find((p) => p.id === y.slug)?.data.picks?.[0];
  return { ...y, href: `/posts/${y.slug}/`, pick: first ? getModel(first.id) : undefined };
});

const faq = [
  {
    q: "What size portable power station do I need?",
    a: "Add up the watt-hours your devices use per day, then add 20% headroom. A 12V fridge plus lights, laptop and phones is roughly 1,500–2,000Wh/day — a 1kWh station covers most of a day, a 2kWh station covers it fully. Our RV sizer does the math for you.",
  },
  {
    q: "How long will a portable power station run a fridge?",
    a: "A full-size fridge draws ~150W while the compressor runs, roughly 1–1.5kWh per day. A 1kWh station (Anker C1000, EcoFlow DELTA 3 Plus) keeps it cold for most of a day; a 2kWh station covers a full day with margin.",
  },
  {
    q: "Are portable power stations better than gas generators?",
    a: "For short outages, electronics and indoor use — yes: silent, no fumes, no fuel runs. For multi-day outages or very heavy loads (central AC), gas still wins on energy density. Many prepared households own both. Our 5-year cost calculator compares them.",
  },
  {
    q: "Can I charge a portable power station with solar panels?",
    a: "Yes — every station we track accepts solar, from 400W to 2,600W of input. Real-world panels deliver ~75% of their label wattage, so size the array generously. Our solar pairing calculator shows recharge times per station.",
  },
];

const jsonLd = [websiteLd(), itemListLd("Top portable power stations of 2026", picks.map((p) => p.model)), faqLd(faq)];
---

<BaseLayout
  title={`${SITE_NAME}: Portable Power Stations Compared (2026)`}
  description={SITE_DESCRIPTION}
  jsonLd={jsonLd}
  hidePromo
>
  <section class="hero">
    <div class="wrap wide hero-grid">
      <div>
        <span class="hero-kicker"><span class="dot" aria-hidden="true"></span>Updated October 2026</span>
        <h1>Portable power stations, <em>compared honestly.</em></h1>
        <p class="lead">
          We compared {MODELS.length} power stations on capacity, output, solar input and price —
          with RV sizers and solar calculators, so you buy the right watt-hours the first time.
        </p>
        <div class="cta-row">
          <a class="btn btn-lg" href="/posts/power-station-vs-generator/">Station vs generator</a>
          <a class="btn secondary btn-lg" href="/tools/rv-sizer/">Size my setup</a>
        </div>
        <div class="hero-proof">
          <div><strong>{MODELS.length}</strong><span>stations compared</span></div>
          <div><strong>{new Set(MODELS.map((m) => m.brand)).size}</strong><span>brands tracked</span></div>
          <div><strong>0</strong><span>lab-test claims we can't back</span></div>
        </div>
      </div>

      <aside class="spotlight" aria-label="Our top pick">
        <div class="sp-ribbon"><span>⚡ #1 {picks[0].label}</span><span>2026</span></div>
        <div class="sp-media"><ProductImage model={top} size={260} eager /></div>
        <div class="sp-body">
          <h2 class="sp-name"><a href={`/power-stations/${top.id}/`}>{top.name}</a></h2>
          <div class="sp-meta">
            <span class="ring-label"><strong>{formatWh(top.capacityWh)} · {top.outputW.toLocaleString("en-US")}W</strong>capacity · continuous output</span>
            <span class="sp-price"><PriceTier model={top} label={false} /><small>{priceTier(top).label} price tier</small></span>
          </div>
          <ul class="sp-points">{top.pros.slice(0, 3).map((p) => <li>{p}</li>)}</ul>
          <BuyButton model={top} size="lg" block />
          <div class="sp-links">
            <a href={`/power-stations/${top.id}/`}>Read the review →</a>
            <a href="/power-stations/">Compare all {MODELS.length}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="trust-bar" aria-label="Why readers trust us">
    <ul>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M8.5 12l2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>Commissions never decide rankings</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>Specs cross-checked across sources</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>Specs refreshed October 2026</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19V9M12 19V5M19 19v-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>Free sizing &amp; solar calculators</li>
    </ul>
  </section>

  <div class="wrap wide">
    <div class="section-head">
      <div>
        <span class="eyebrow">Editor's picks</span>
        <h2 class="section-title">The 4 power stations we'd buy in 2026</h2>
        <p class="section-sub">One clear winner for each job. Tap a card for the full review.</p>
      </div>
      <a class="section-link" href="/power-stations/">Compare all →</a>
    </div>
    <div class="tp-grid four">
      {picks.map((p, i) => <ProductCard model={p.model} label={p.label} featured={i === 0} accent={ACCENTS[i]} />)}
    </div>
    <p class="swipe-hint">Swipe for more picks →</p>

    <div class="section-head">
      <div>
        <span class="eyebrow">Shop by use case</span>
        <h2 class="section-title">Best power station for your situation</h2>
      </div>
      <a class="section-link" href="/guides/">All guides →</a>
    </div>
    <div class="yard-grid">
      {useCases.map((y) => (
        <div class="yard">
          <div class="yard-top">
            <div class="yard-icon" aria-hidden="true">{y.icon}</div>
            <h3><a href={y.href}>{y.title}</a></h3>
          </div>
          <p>{y.text}</p>
          {y.pick && (
            <div class="yard-pick">
              <span><small>Top pick</small><strong>{y.pick.shortName}</strong></span>
              <BuyButton model={y.pick} label="Check price" size="sm" />
            </div>
          )}
          <span class="go">Read the guide</span>
        </div>
      ))}
    </div>

    <div class="section-head">
      <div>
        <span class="eyebrow">Side by side</span>
        <h2 class="section-title">Biggest batteries at a glance</h2>
      </div>
      <a class="section-link" href="/power-stations/">Compare all {MODELS.length} →</a>
    </div>
    <ComparisonTable models={topModels} />

    <div class="section-head">
      <div>
        <span class="eyebrow">Free tools</span>
        <h2 class="section-title">Don't guess. Calculate.</h2>
      </div>
      <a class="section-link" href="/tools/">All tools →</a>
    </div>
    <div class="tool-grid">
      <a class="tool-card" href="/tools/rv-sizer/">
        <div class="tool-icon">🚐</div>
        <h3>RV & Vanlife Power Sizer</h3>
        <p>Check off your devices and get the battery size you actually need, with matching stations.</p>
        <span class="go">Size my setup</span>
      </a>
      <a class="tool-card" href="/tools/solar-pairing/">
        <div class="tool-icon">☀️</div>
        <h3>Solar Pairing Calculator</h3>
        <p>See real recharge times for your panels on every station — and spot clipped arrays.</p>
        <span class="go">Pair my panels</span>
      </a>
      <a class="tool-card" href="/tools/generator-cost/">
        <div class="tool-icon">⚖️</div>
        <h3>Station vs Generator: 5-Year Cost</h3>
        <p>Fuel, maintenance and upfront cost side by side for your outage hours.</p>
        <span class="go">Do the math</span>
      </a>
    </div>

    <div class="section-head">
      <div>
        <span class="eyebrow">Buying advice</span>
        <h2 class="section-title">Comparisons &amp; guides</h2>
      </div>
      <a class="section-link" href="/guides/">All guides →</a>
    </div>
    <div class="post-grid">
      {guides.map((post) => <PostCard post={post} />)}
    </div>

    <section class="strip" aria-label="Why trust this guide">
      <div>
        <h2>Research you can actually check.</h2>
        <p>We earn a commission when you buy through our links, but it never changes which station we recommend. No lab-test theater — just specs, cross-checked.</p>
        <a class="btn" href="/how-we-research/">How we research</a>
      </div>
      <div class="strip-items">
        <div><div class="n">01</div><h3>Long-tail, not listicles</h3><p>We answer specific questions — RV sizing, solar pairing, generator math — instead of re-ranking "best power station" for the tenth time.</p></div>
        <div><div class="n">02</div><h3>Specs, cross-checked</h3><p>Capacity, output and solar figures verified across manufacturers, retailers and published reviews, with sources on every model.</p></div>
        <div><div class="n">03</div><h3>Tools, not just words</h3><p>Calculators built from real specs turn "which station?" into a number, not a guess.</p></div>
      </div>
    </section>

    <section class="faq home-faq" aria-label="Frequently asked questions">
      <h2 class="section-title">Power station FAQ</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><div>{f.a}</div></details>)}
    </section>
  </div>

  <StickyCta model={top} label={`#1 ${picks[0].label}`} showAfter={1400} />
</BaseLayout>
