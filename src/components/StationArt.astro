---
// Stylized power-station illustration used whenever no licensed product photo
// exists in src/assets/power-stations/. A rounded battery box with a display,
// outlets and a lightning bolt, tinted per brand.
import type { StationModel } from "../data/models";

interface Props {
  model: StationModel;
  size?: number;
}
const { model: m, size = 96 } = Astro.props;

const COLORS: Record<string, [string, string]> = {
  EcoFlow: ["#1f2937", "#facc15"],
  Anker: ["#e2e8f0", "#0ea5e9"],
  Jackery: ["#f97316", "#1f2937"],
  BLUETTI: ["#1e3a8a", "#38bdf8"],
  DJI: ["#111827", "#9ca3af"],
};
const [body, accent] = COLORS[m.brand] ?? ["#1f2937", "#a3e635"];
const light = ["Anker"].includes(m.brand);
const detail = light ? "#475569" : "#cbd5e1";
const uid = `s-${m.id}-${Math.random().toString(36).slice(2, 7)}`;
const w = size;
const h = Math.round(size * 0.72);
---

<svg
  width={w}
  height={h}
  viewBox="0 0 200 144"
  role="img"
  aria-label={`${m.name} illustration`}
  class="station-art"
>
  <defs>
    <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={body} stop-opacity="0.92" />
      <stop offset="1" stop-color={body} />
    </linearGradient>
  </defs>
  <!-- body -->
  <rect x="28" y="30" width="144" height="92" rx="14" fill={`url(#${uid}-bg)`} stroke={detail} stroke-opacity="0.35" stroke-width="2" />
  <!-- handle -->
  <rect x="70" y="14" width="60" height="18" rx="9" fill="none" stroke={detail} stroke-opacity="0.6" stroke-width="5" />
  <!-- display -->
  <rect x="44" y="46" width="52" height="30" rx="6" fill="#0f172a" />
  <text x="70" y="66" text-anchor="middle" font-family="monospace" font-size="13" fill={accent}>100%</text>
  <!-- AC outlets -->
  <rect x="108" y="46" width="20" height="14" rx="3" fill="none" stroke={detail} stroke-width="2.5" />
  <rect x="134" y="46" width="20" height="14" rx="3" fill="none" stroke={detail} stroke-width="2.5" />
  <!-- lightning bolt -->
  <path d="M104 76 L88 100 L100 100 L92 118 L114 92 L102 92 Z" fill={accent} />
  <!-- USB ports -->
  <rect x="44" y="88" width="26" height="10" rx="5" fill="none" stroke={detail} stroke-opacity="0.7" stroke-width="2" />
  <rect x="76" y="88" width="26" height="10" rx="5" fill="none" stroke={detail} stroke-opacity="0.7" stroke-width="2" />
  <!-- vent lines -->
  <g stroke={detail} stroke-opacity="0.4" stroke-width="2.5" stroke-linecap="round">
    <line x1="120" y1="88" x2="156" y2="88" />
    <line x1="120" y1="98" x2="156" y2="98" />
    <line x1="120" y1="108" x2="148" y2="108" />
  </g>
  <!-- feet -->
  <rect x="44" y="122" width="22" height="8" rx="4" fill={detail} stroke-opacity="0.5" />
  <rect x="134" y="122" width="22" height="8" rx="4" fill={detail} stroke-opacity="0.5" />
</svg>
